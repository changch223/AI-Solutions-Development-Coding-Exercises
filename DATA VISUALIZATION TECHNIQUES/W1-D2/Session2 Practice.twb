            <column caption='c_Arrow+' datatype='string' name='[Calculation_1733604446095568896]' role='measure' type='nominal'>
              <calculation class='tableau' formula='If [Calculation_2472757734248914949] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;END'>
