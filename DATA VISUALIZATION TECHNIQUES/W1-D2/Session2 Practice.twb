      <size sizing-mode='automatic' />
      <datasources>
        <datasource name='Parameters' />
        <datasource name='Sample - Superstore' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='p_Week' datatype='date' default-format='*&quot;week&quot; wwww yyyy' name='[パラメーター 1]' param-domain-type='any' role='measure' type='quantitative' value='#2024-08-12#'>
          <calculation class='tableau' formula='#2024-08-12#' />
        </column>
        <column caption='p_Conversion Rate' datatype='real' name='[パラメーター 2]' param-domain-type='range' role='measure' type='quantitative' value='1.25'>
          <calculation class='tableau' formula='1.25' />
          <range granularity='0.05' max='1.35' min='1.0' />
        </column>
        <column caption='p_Currency' datatype='string' name='[パラメーター 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;USD&quot;'>
          <calculation class='tableau' formula='&quot;USD&quot;' />
          <members>
            <member value='&quot;USD&quot;' />
            <member value='&quot;CAD&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='Sample - Superstore'>
        <column datatype='string' name='[Country/Region]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
        <column aggregate-role-from='[State/Province]' datatype='string' name='[Region]' role='dimension' type='nominal' />
        <column-instance column='[Country/Region]' derivation='None' name='[none:Country/Region:nk]' pivot='key' type='nominal' />
        <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
        <column-instance column='[Order Date]' derivation='Year' name='[yr:Order Date:ok]' pivot='key' type='ordinal' />
      </datasource-dependencies>
