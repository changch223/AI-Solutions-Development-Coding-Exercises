              <calculation class='tableau' formula='IF [Calculation_2472757734248914949]&lt;=0 AND [Calculation_2472757734248914949]&gt;-.15 THEN &quot;NEGATIVE 0-15%&quot;&#13;&#10;ELSEIF [Calculation_2472757734248914949] &lt;=-.15 AND [Calculation_2472757734248914949] &gt;-.30 THEN &quot;NEGATIVE 15-30%&quot;&#13;&#10;ELSEIF [Calculation_2472757734248914949]&lt;=-.30 AND [Calculation_2472757734248914949]&gt;-1 THEN &quot;NEGATIVE OVER 30%&quot;&#13;&#10;ELSEIF [Calculation_2472757734248914949] &gt;=.30 THEN &quot;OVER 30%&quot;&#13;&#10;ELSEIF [Calculation_2472757734248914949]&gt;=0 AND [Calculation_2472757734248914949]&lt;.15 THEN &quot;0-15%&quot;&#13;&#10;ELSEIF [Calculation_2472757734248914949]&gt;=.15 AND [Calculation_2472757734248914949]&lt;.30 THEN &quot;15-30%&quot;&#13;&#10;ELSE Null&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c_Sales by Currency' datatype='real' name='[Calculation_2472757734255935498]' role='measure' type='quantitative'>
