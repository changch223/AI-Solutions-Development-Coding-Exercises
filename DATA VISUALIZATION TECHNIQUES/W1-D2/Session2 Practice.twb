      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='c_Arrow+' datatype='string' name='[Calculation_1733604446095568896]' role='measure' type='nominal'>
        <calculation class='tableau' formula='If [Calculation_2472757734248914949] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c_Arrow-' datatype='string' name='[Calculation_1733604446095777793]' role='measure' type='nominal'>
        <calculation class='tableau' formula='If [Calculation_2472757734248914949] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c_Arrow0' datatype='string' name='[Calculation_1733604446095888386]' role='measure' type='nominal'>
        <calculation class='tableau' formula='If [Calculation_2472757734248914949] = 0&#13;&#10;THEN &quot;▼▲&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c_Sale_$Diff' datatype='real' name='[Calculation_2472757734248804356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[パラメーター 3] = &quot;CAD&quot; THEN&#13;&#10;(SUM([Sales])- LOOKUP(SUM([Sales]), -1)) * [Parameters].[パラメーター 2]&#13;&#10;ELSE&#13;&#10;(SUM([Sales])- LOOKUP(SUM([Sales]), -1))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c_Sales_%Diff' datatype='real' name='[Calculation_2472757734248914949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -1))/ LOOKUP(ZN(SUM([Sales])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c_Week#' datatype='datetime' name='[Calculation_2472757734250446854]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [Order Date])' />
      </column>
      <column caption='c_Sales of the last 4 Weeks' datatype='boolean' name='[Calculation_2472757734250823687]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_2472757734250446854] &lt; DATETRUNC (&apos;week&apos;,[Parameters].[パラメーター 1])&#13;&#10;AND&#13;&#10;[Calculation_2472757734250446854] &gt;= DATEADD(&apos;week&apos;, -5 ,DATETRUNC(&apos;week&apos;,[Parameters].[パラメーター 1]))' />
      </column>
      <column caption='c_Color' datatype='string' name='[Calculation_2472757734253113352]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2472757734248914949]&lt;=0 AND [Calculation_2472757734248914949]&gt;-.15 THEN &quot;NEGATIVE 0-15%&quot;&#13;&#10;ELSEIF [Calculation_2472757734248914949] &lt;=-.15 AND [Calculation_2472757734248914949] &gt;-.30 THEN &quot;NEGATIVE 15-30%&quot;&#13;&#10;ELSEIF [Calculation_2472757734248914949]&lt;=-.30 AND [Calculation_2472757734248914949]&gt;-1 THEN &quot;NEGATIVE OVER 30%&quot;&#13;&#10;ELSEIF [Calculation_2472757734248914949] &gt;=.30 THEN &quot;OVER 30%&quot;&#13;&#10;ELSEIF [Calculation_2472757734248914949]&gt;=0 AND [Calculation_2472757734248914949]&lt;.15 THEN &quot;0-15%&quot;&#13;&#10;ELSEIF [Calculation_2472757734248914949]&gt;=.15 AND [Calculation_2472757734248914949]&lt;.30 THEN &quot;15-30%&quot;&#13;&#10;ELSE Null&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c_Sales by Currency' datatype='real' name='[Calculation_2472757734255935498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[パラメーター 3] = &quot;CAD&quot; THEN SUM([Sales]) * [Parameters].[パラメーター 2]&#13;&#10;ELSE&#13;&#10;SUM([Sales])&#13;&#10;END' />
      </column>
