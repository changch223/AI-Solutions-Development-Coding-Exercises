    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='Top Customers' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='5'>
        <calculation class='tableau' formula='5' />
        <range granularity='5' max='20' min='5' />
      </column>
      <column caption='Profit Bin Size' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='200'>
        <calculation class='tableau' formula='200' />
        <range granularity='50' max='200' min='50' />
      </column>
      <column caption='p_Week' datatype='date' default-format='*&quot;week&quot; wwww yyyy' name='[パラメーター 1]' param-domain-type='any' role='measure' type='quantitative' value='#2024-08-12#'>
        <calculation class='tableau' formula='#2024-08-12#' />
      </column>
      <column caption='p_Conversion Rate' datatype='real' name='[パラメーター 2]' param-domain-type='range' role='measure' type='quantitative' value='1.25'>
        <calculation class='tableau' formula='1.25' />
        <range granularity='0.05' max='1.35' min='1.0' />
      </column>
      <column caption='p_Currency' datatype='string' name='[パラメーター 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;USD&quot;'>
        <calculation class='tableau' formula='&quot;USD&quot;' />
        <members>
          <member value='&quot;USD&quot;' />
          <member value='&quot;CAD&quot;' />
        </members>
      </column>
    </datasource>
