      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='py_Profit Ratio' datatype='real' name='[Calculation_788974426016346112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_REAL(&quot;&#13;&#10;ratio = []&#13;&#10;for i in range(0,len(_arg1)):&#13;&#10;     ratio.append(_arg2[i]/_arg1[i]*100)&#13;&#10;     return ratio&#13;&#10;&quot;,SUM([Sales]), SUM([Profit]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='py_Sales Polynomail (ax+b)' datatype='real' name='[Calculation_788974426018062337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_REAL(&quot;&#13;&#10;import numpy as np&#13;&#10;p = np.poly1d([0.5,100])&#13;&#10;return p(_arg1).tolist()&#13;&#10;&quot;, SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='py_Profitable Sales' datatype='boolean' name='[Calculation_788974426018840578]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SCRIPT_BOOL(&quot;&#13;&#10;lst = []&#13;&#10;for i in _arg1:&#13;&#10; lst.append(i&gt;0)&#13;&#10;return lst&#13;&#10;&quot;,&#13;&#10;SUM([Profit])&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='py_Curve (x2)' datatype='real' name='[Calculation_788974426019586051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_REAL(&quot;&#13;&#10;import numpy as np&#13;&#10;x = np.linspace(-5,5,100)&#13;&#10;return[x**2 for x in _arg1]&quot;, SUM([Profit]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='py_Linear Regression' datatype='real' name='[Calculation_788974426020524036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_REAL(&apos;&#13;&#10;import numpy as np&#13;&#10;from sklearn import linear_model&#13;&#10;clf=linear_model.LinearRegression()&#13;&#10;x=np.transpose(np.array([_arg1]))&#13;&#10;y=np.array(_arg2)&#13;&#10;clf.fit(x,y)&#13;&#10;return clf.predict(x).tolist()&apos;,&#13;&#10;SUM([Sales]),SUM([Profit]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='py_Corrcoef' datatype='real' name='[Calculation_788974426023030789]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_REAL(&quot;import numpy as np&#13;&#10;return np.corrcoef(_arg1,_arg2)[0,1]&quot;,&#13;&#10;SUM([Sales]),SUM([Profit]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c_Matching Value' datatype='boolean' name='[Calculation_788974426024116231]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Sub-Category] = [Sub-Category (Orders1)]' />
      </column>
      <column caption='c_Sales Correlation' datatype='real' name='[Calculation_788974426024255496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CORR( { INCLUDE [Customer Name] : SUM( [Sales (Orders1)])},&#13;&#10;      { INCLUDE [Customer Name] : SUM( [Sales])})' />
      </column>
